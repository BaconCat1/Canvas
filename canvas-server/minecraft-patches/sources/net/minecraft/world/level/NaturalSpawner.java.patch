+    // Canvas start - optimize natural spawning
+    private static int[] calculateLimits(final io.papermc.paper.threadedregions.RegionizedWorldData worldData, final int spawnableChunkCount) {
+        int[] limits = new int[MobCategory.values().length];
+        ServerLevel level = worldData.world;
+        for (MobCategory category : SPAWNING_CATEGORIES) {
+            int rawLimit = level.getWorld().getSpawnLimit(org.bukkit.craftbukkit.util.CraftSpawnCategory.toBukkit(category));
+            limits[category.ordinal()] = rawLimit * spawnableChunkCount / MAGIC_NUMBER;
+        }
+        return limits;
+    }
+
+    public static NaturalSpawner.SpawnState createState(
+        final int spawnableChunkCount,
+        final LocalMobCapCalculator localMobCapCalculator,
+        final boolean countMobs,
+        final io.papermc.paper.threadedregions.RegionizedWorldData worldData
+    ) {
+        PotentialCalculator spawnPotential = new PotentialCalculator();
+        Object2IntOpenHashMap<MobCategory> mobCounts = new Object2IntOpenHashMap<>();
+        int[] limits = calculateLimits(worldData, spawnableChunkCount);
+        boolean perPlayerMobSpawning = worldData.world.paperConfig().entities.spawning.perPlayerMobSpawns;
+
+        for (LevelChunk chunk : worldData.getChunks().getRawDataUnchecked()) {
+            if (chunk == null) {
+                continue;
+            }
+            for (Entity entity : chunk.moonrise$getChunkHolder().getEntityChunk().getEntityArr()) {
+                if (entity == null || entity instanceof Mob mob && (mob.isPersistenceRequired() || mob.requiresCustomPersistence())) {
+                    continue;
+                }
+
+                MobCategory category = entity.getType().getCategory();
+                if (category == MobCategory.MISC) {
+                    continue;
+                }
+                boolean limitReached = limits[category.ordinal()] <= mobCounts.getInt(category);
+                if (!perPlayerMobSpawning && limitReached) {
+                    continue;
+                }
+                if (!entity.level().paperConfig().entities.spawning.countAllMobsForSpawning
+                    && entity.spawnReason != org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.NATURAL
+                    && entity.spawnReason != org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.CHUNK_GEN) {
+                    continue;
+                }
+
+                BlockPos pos = entity.blockPosition();
+                if (!perPlayerMobSpawning || !limitReached) {
+                    MobSpawnSettings naturalMobSpawns = worldData.world.environmentAttributes().getValue(EnvironmentAttributes.NATURAL_MOB_SPAWNS, pos);
+                    MobSpawnSettings.MobSpawnCost mobSpawnCost = naturalMobSpawns.getMobSpawnCost(entity.getType());
+                    if (mobSpawnCost != null) {
+                        spawnPotential.addCharge(pos, mobSpawnCost.charge());
+                    }
+                }
+                if (localMobCapCalculator != null && entity instanceof Mob) {
+                    localMobCapCalculator.addMob(chunk.getPos(), category);
+                }
+                mobCounts.addTo(category, 1);
+                if (countMobs) {
+                    worldData.world.getChunkSource().chunkMap.updatePlayerMobTypeMap(entity);
+                }
+            }
+        }
+
+        return new NaturalSpawner.SpawnState(spawnableChunkCount, mobCounts, spawnPotential, localMobCapCalculator);
+    }

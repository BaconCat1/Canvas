+    // Canvas start - restore detached fishing hook portal behavior
+    public void canvas$updateEnderPearlSnapshot(final ThrownEnderpearl enderPearl) {
+        if (!this.level().canvasConfig().combat.restoreDetachedFishingHookPortalBug) {
+            return;
+        }
+        this.canvas$enderPearlSnapshots.put(enderPearl.getUUID(), new CanvasEnderPearlSnapshot(enderPearl.level().dimension(), enderPearl.chunkPosition().pack()));
+    }
+
+    /**
+     * Returns true if this player has an active ender pearl in a chunk *adjacent* to
+     * (Chebyshev distance 1, not equal to) the hook's chunk in the same dimension.
+     * That is the configuration in which the vanilla "stasis chamber" bug applies:
+     * the pearl's chunk-loading ticket keeps its own chunk at level 31 and propagates
+     * level 32 to the surrounding ring, which keeps the bobber's chunk loaded for
+     * blocks/redstone but stops it from entity-ticking.
+     */
+    public boolean canvas$hasAdjacentPearlForHook(final net.minecraft.resources.ResourceKey<net.minecraft.world.level.Level> dimension, final long hookChunkPos) {
+        final int hookX = net.minecraft.world.level.ChunkPos.getX(hookChunkPos);
+        final int hookZ = net.minecraft.world.level.ChunkPos.getZ(hookChunkPos);
+        for (CanvasEnderPearlSnapshot snapshot : this.canvas$enderPearlSnapshots.values()) {
+            if (!snapshot.dimension.equals(dimension)) {
+                continue;
+            }
+            final int dx = Math.abs(net.minecraft.world.level.ChunkPos.getX(snapshot.chunkPos) - hookX);
+            final int dz = Math.abs(net.minecraft.world.level.ChunkPos.getZ(snapshot.chunkPos) - hookZ);
+            if (dx <= 1 && dz <= 1 && (dx | dz) != 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private record CanvasEnderPearlSnapshot(net.minecraft.resources.ResourceKey<net.minecraft.world.level.Level> dimension, long chunkPos) {
+    }
+    // Canvas end - restore detached fishing hook portal behavior
+

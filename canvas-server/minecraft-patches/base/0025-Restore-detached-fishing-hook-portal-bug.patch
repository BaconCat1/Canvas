+    // Canvas start - restore detached fishing hook portal behavior
+    private void canvas$retrieveFromDifferentRegion(final ServerPlayer owner, final net.minecraft.world.InteractionHand hand) {
+        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this) || this.isRemoved()) {
+            return;
+        }
+        // Cross-region retrieve cannot safely fire vanilla fishing events or pull the
+        // hooked entity (its region may not be ours). Apply the in-ground rod damage
+        // (matching what the bobber would yield in vanilla when sitting on a block,
+        // i.e. the stasis-chamber case) and discard the hook. Damage is applied back
+        // on the owner's region.
+        final int damage = this.onGround() ? 2 : 0;
+        this.level().broadcastEntityEvent(this, EntityEvent.FISHING_ROD_REEL_IN);
+        this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DESPAWN); // CraftBukkit - add Bukkit remove cause
+        if (!owner.isRemoved()) {
+            owner.getBukkitEntity().taskScheduler.scheduleOrExecute((ServerPlayer player) -> player.getItemInHand(hand).hurtAndBreak(damage, player, hand.asEquipmentSlot()));
+        }
+    }

+        if (this.level().canvasConfig().combat.restoreDetachedFishingHookPortalBug
+            && this.canvas$detachedPortalBugActive
+            && this.canvas$detachedOwnerUuid != null) {
+            Entity rawOwner = this.getOwnerRaw();

diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
index fb4aafe4..80da121d 100644
--- a/net/minecraft/world/entity/player/Player.java
+++ b/net/minecraft/world/entity/player/Player.java
@@ -1368,6 +1368,22 @@ public abstract class Player extends Avatar implements ContainerUser {
     @Override
     protected void preRemove(RemovalReason reason) {
         super.preRemove(reason);
+        // Canvas start - restore detached fishing hook portal behavior
+        // Vanilla "detached fishing hook portal bug" / stasis chamber mechanic: the
+        // bobber and pressure plate are built on a chunk border with an active ender
+        // pearl in the *adjacent* chunk. The pearl's chunk-loading ticket keeps the
+        // hook's chunk loaded at level 32 (block-ticking but not entity-ticking), so
+        // the bobber stops ticking entirely and stays put on the plate. We only preserve
+        // the player->hook reference here when that exact configuration is in effect.
+        if (reason == RemovalReason.CHANGED_DIMENSION
+            && this.level().canvasConfig().combat.restoreDetachedFishingHookPortalBug
+            && this.fishing != null
+            && this instanceof net.minecraft.server.level.ServerPlayer serverPlayer
+            && serverPlayer.canvas$hasAdjacentPearlForHook(this.level().dimension(), this.fishing.canvas$getHookChunkPositionSnapshot())) {
+            this.fishing.canvas$markPortalTransferState(true, this.getUUID());
+            return;
+        }
+        // Canvas end - restore detached fishing hook portal behavior
         this.fishing = null;
     }
     // Folia end - region threading

+    // Canvas start - diagnose keepalive latency spikes
+    public void canvas$recordKeepAliveSchedulingContext(
+        final long challengeId,
+        final Class<?> pendingQueueHead,
+        final boolean pendingQueueHeadReady,
+        final int eventLoopTasks,
+        final boolean channelWritable,
+        final boolean bypassedPendingQueue,
+        final String schedulingThread
+    ) {
+        final io.papermc.paper.util.KeepAlive.PendingKeepAlive pending = this.canvas$findPendingKeepAlive(challengeId);
+        if (pending != null) {
+            pending.recordSchedulingContext(
+                pendingQueueHead, pendingQueueHeadReady, eventLoopTasks, channelWritable, bypassedPendingQueue, schedulingThread
+            );
+        }
+    }
+
+    public void canvas$markKeepAliveDispatched(final long challengeId, final long dispatchTimeNS) {
+        final io.papermc.paper.util.KeepAlive.PendingKeepAlive pending = this.canvas$findPendingKeepAlive(challengeId);
+        if (pending != null) {
+            pending.markDispatched(dispatchTimeNS);
+        }
+    }
+
+    private io.papermc.paper.util.KeepAlive.@Nullable PendingKeepAlive canvas$findPendingKeepAlive(final long challengeId) {
+        for (final io.papermc.paper.util.KeepAlive.PendingKeepAlive pending : this.keepAlive.pendingKeepAlives) {
+            if (pending.challengeId() == challengeId) {
+                return pending;
+            }
+        }
+        return null;
+    }
+
+    private void canvas$logKeepAliveDiagnostic(
+        final io.papermc.paper.util.KeepAlive.PendingKeepAlive pending,
+        final io.canvasmc.canvas.network.KeepAliveDiagnostics.Timing timing,
+        final long now
+    ) {
+        final io.canvasmc.canvas.GlobalConfiguration.Networking config = io.canvasmc.canvas.GlobalConfiguration.getInstance().networking;
+        if (!config.keepaliveDiagnostics
+            || !timing.exceeds(java.util.concurrent.TimeUnit.MILLISECONDS.toNanos(config.keepaliveDiagnosticThresholdMillis))) {
+            return;
+        }
+
+        final long logIntervalNS = java.util.concurrent.TimeUnit.SECONDS.toNanos(config.keepaliveDiagnosticLogIntervalSeconds);
+        if (this.canvas$lastKeepAliveDiagnosticTimeNS != Long.MIN_VALUE
+            && now - this.canvas$lastKeepAliveDiagnosticTimeNS < logIntervalNS) {
+            return;
+        }
+        this.canvas$lastKeepAliveDiagnosticTimeNS = now;
+
+        final Class<?> pendingQueueHead = pending.pendingQueueHead();
+        LOGGER.warn(
+            "Keepalive latency spike for {}: total={}ms, serverDispatch={}ms, networkRoundTrip={}ms, likelyCause={}, bypassedPendingQueue={}, pendingQueueHead={} (ready={}), nettyPendingTasks={}, channelWritable={}, schedulingThread={}",
+            this.playerProfile().name(),
+            java.util.concurrent.TimeUnit.NANOSECONDS.toMillis(timing.totalTimeNs()),
+            timing.hasDispatchTime() ? java.util.concurrent.TimeUnit.NANOSECONDS.toMillis(timing.dispatchDelayNs()) : "unknown",
+            timing.hasDispatchTime() ? java.util.concurrent.TimeUnit.NANOSECONDS.toMillis(timing.networkRoundTripNs()) : "unknown",
+            timing.likelyCause(),
+            pending.bypassedPendingQueue(),
+            pendingQueueHead == null ? "none" : pendingQueueHead.getName(),
+            pending.pendingQueueHeadReady(),
+            pending.eventLoopTasks(),
+            pending.channelWritable(),
+            pending.schedulingThread()
+        );
+    }
+    // Canvas end - diagnose keepalive latency spikes
+
     @Override
     public void handlePong(final ServerboundPongPacket serverboundPongPacket) {
     }

+    // Canvas start - distinguish server dispatch delay from player ping
+    public static final class PendingKeepAlive {
+        private final long txTimeNS;
+        private final long challengeId;
+        private volatile long dispatchTimeNS;
+        private volatile Class<?> pendingQueueHead;
+        private volatile boolean pendingQueueHeadReady;
+        private volatile int eventLoopTasks;
+        private volatile boolean channelWritable;
+        private volatile boolean bypassedPendingQueue;
+        private volatile String schedulingThread;
+
+        public PendingKeepAlive(final long txTimeNS, final long challengeId) {
+            this.txTimeNS = txTimeNS;
+            this.challengeId = challengeId;
+            this.eventLoopTasks = -1;
+            this.pendingQueueHeadReady = true;
+        }
+
+        public long txTimeNS() {
+            return this.txTimeNS;
+        }
+
+        public long challengeId() {
+            return this.challengeId;
+        }
+
+        public long dispatchTimeNS() {
+            return this.dispatchTimeNS;
+        }
+
+        public Class<?> pendingQueueHead() {
+            return this.pendingQueueHead;
+        }
+
+        public boolean pendingQueueHeadReady() {
+            return this.pendingQueueHeadReady;
+        }
+
+        public int eventLoopTasks() {
+            return this.eventLoopTasks;
+        }
+
+        public boolean channelWritable() {
+            return this.channelWritable;
+        }
+
+        public boolean bypassedPendingQueue() {
+            return this.bypassedPendingQueue;
+        }
+
+        public String schedulingThread() {
+            return this.schedulingThread;
+        }
+
+        public void recordSchedulingContext(
+            final Class<?> pendingQueueHead,
+            final boolean pendingQueueHeadReady,
+            final int eventLoopTasks,
+            final boolean channelWritable,
+            final boolean bypassedPendingQueue,
+            final String schedulingThread
+        ) {
+            this.pendingQueueHead = pendingQueueHead;
+            this.pendingQueueHeadReady = pendingQueueHeadReady;
+            this.eventLoopTasks = eventLoopTasks;
+            this.channelWritable = channelWritable;
+            this.bypassedPendingQueue = bypassedPendingQueue;
+            this.schedulingThread = schedulingThread;
+        }
+
+        public void markDispatched(final long dispatchTimeNS) {
+            this.dispatchTimeNS = dispatchTimeNS;
+        }
+    }
+    // Canvas end - distinguish server dispatch delay from player ping
 
     public final ca.spottedleaf.concurrentutil.collection.MultiThreadedQueue<PendingKeepAlive> pendingKeepAlives = new ca.spottedleaf.concurrentutil.collection.MultiThreadedQueue<>();
 
